# Copy this file to ".env" and fill in what you need.  NEVER commit ".env".
# (".env" is listed in .gitignore, so Git ignores it.)

# Port the Express server listens on.
PORT=3000

# OPTIONAL. Open-Meteo is free without a key. If you buy a commercial plan you get
# an API key: put it here and the server switches to the "customer-" endpoints and
# adds the key to every request ITSELF. The browser never sees it.
OPEN_METEO_API_KEY=

# How many API requests one visitor (IP address) may make per minute.
RATE_LIMIT_PER_MINUTE=120

# Proxies between the visitor and this server (HAProxy + Nginx = 2).
TRUST_PROXY_HOPS=2
